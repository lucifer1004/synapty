{
  "_attribution": "Rule content ported from the herdr project's battle-tested detection manifests (src/detect/manifests/cursor.toml, Apache-2.0), remapped to RFC-0004 vocabulary: blocked->waiting, idle->done. Nested any/all conjunctions flattened into rule multiplication or regex alternations; osc_progress rules dropped (no channel); loosenings noted inline where exact fidelity was impossible.",
  "tool": "cursor",
  "rules": [
    {
      "id": "write_file_approval",
      "state": "waiting",
      "region": "bottom(8)",
      "all": [
        "write to this file?",
        "proceed (y)"
      ],
      "any": [
        "reject & propose changes",
        "esc or n or p",
        "add write("
      ]
    },
    {
      "id": "approval_run_command",
      "state": "waiting",
      "all": [
        "waiting for approval",
        "run this command?"
      ],
      "any": [
        "run (once) (y)",
        "skip (esc or n)"
      ]
    },
    {
      "id": "approval_hints",
      "state": "waiting",
      "any": [
        "(y) (enter)",
        "keep (n)",
        "skip (esc or n)"
      ]
    },
    {
      "id": "approval_allow_line",
      "state": "waiting",
      "lineRegex": "(?i)^\\s*allow .*\\(y\\)"
    },
    {
      "id": "approval_run_line",
      "state": "waiting",
      "lineRegex": "(?i)^\\s*(?:→\\s*)?run .*\\(y\\)"
    },
    {
      "id": "stop_hint_working",
      "state": "working",
      "region": "bottom(6)",
      "contains": "ctrl+c to stop"
    },
    {
      "id": "background_tasks_working",
      "state": "working",
      "region": "bottom(5)",
      "lineRegex": "(?i)\\b[1-9][0-9]*\\s+background\\s+tasks?\\b"
    },
    {
      "id": "spinner_working",
      "state": "working",
      "region": "bottom(8)",
      "lineRegex": "^\\s*(⬡|⬢|[\\u2800-\\u28FF]+)\\s+\\p{Alphabetic}+\\w*ing\\b"
    }
  ]
}
