From 01e241aebd35fa8a499bbd38e1c949a4c349c07e Mon Sep 17 00:00:00 2001
From: Synapty local <synapty@local>
Date: Sun, 2 Aug 2026 22:11:16 +0800
Subject: [PATCH] build: allow overriding metal compiler via SYNAPTY_METAL_DIR

Local patch: Xcode 26.6's Metal Toolchain component cannot be downloaded
on this machine (Apple catalog failures). The cryptex toolchain from the
system asset (/Volumes/MetalToolchainCryptex/Metal.xctoolchain/usr/bin)
is used directly instead of /usr/bin/xcrun metal.

SYNAPTY_METAL_DIR=<usr/bin of metal toolchain> and optionally
SYNAPTY_METAL_CACHE=<writable dir> make  use the direct
compiler. Remove once xcodebuild -downloadComponent MetalToolchain works.
---
 src/build/MetallibStep.zig | 27 +++++++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/build/MetallibStep.zig b/src/build/MetallibStep.zig
index fcf3055f8..0811beb21 100644
--- a/src/build/MetallibStep.zig
+++ b/src/build/MetallibStep.zig
@@ -51,11 +51,26 @@ pub fn create(b: *std.Build, opts: Options) ?*MetallibStep {
         else => unreachable,
     };
 
+    // Local patch: SYNAPTY_METAL_DIR overrides the xcrun-discovered metal
+    // compiler. Needed while Xcode's Metal Toolchain component cannot be
+    // downloaded (Apple catalog failures); the mounted cryptex toolchain
+    // (/Volumes/MetalToolchainCryptex/Metal.xctoolchain/usr/bin) is used
+    // directly. Remove once xcodebuild -downloadComponent MetalToolchain
+    // works on this machine.
+    const env = &b.graph.environ_map;
+    const metal_dir = env.get("SYNAPTY_METAL_DIR");
+    const metal_cache = env.get("SYNAPTY_METAL_CACHE") orelse
+        b.fmt("{s}/.metal-cache", .{b.build_root.path.?});
+
     const run_ir = RunStep.create(
         b,
         b.fmt("metal {s}", .{opts.name}),
     );
-    run_ir.addArgs(&.{ "/usr/bin/xcrun", "-sdk", sdk, "metal", "-o" });
+    if (metal_dir) |dir| {
+        run_ir.addArgs(&.{ b.fmt("{s}/metal", .{dir}), "-o" });
+    } else {
+        run_ir.addArgs(&.{ "/usr/bin/xcrun", "-sdk", sdk, "metal", "-o" });
+    }
     const output_ir = run_ir.addOutputFileArg(b.fmt("{s}.ir", .{opts.name}));
     run_ir.addArgs(&.{"-c"});
     for (opts.sources) |source| run_ir.addFileArg(source);
@@ -65,12 +80,20 @@ pub fn create(b: *std.Build, opts: Options) ?*MetallibStep {
             .{ arg, min_version },
         )});
     }
+    if (metal_dir != null) {
+        // Direct metal invocations need a writable module cache.
+        run_ir.addArgs(&.{ b.fmt("-fmodules-cache-path={s}", .{metal_cache}) });
+    }
 
     const run_lib = RunStep.create(
         b,
         b.fmt("metallib {s}", .{opts.name}),
     );
-    run_lib.addArgs(&.{ "/usr/bin/xcrun", "-sdk", sdk, "metallib", "-o" });
+    if (metal_dir) |dir| {
+        run_lib.addArgs(&.{ b.fmt("{s}/metallib", .{dir}), "-o" });
+    } else {
+        run_lib.addArgs(&.{ "/usr/bin/xcrun", "-sdk", sdk, "metallib", "-o" });
+    }
     const output_lib = run_lib.addOutputFileArg(b.fmt("{s}.metallib", .{opts.name}));
     run_lib.addFileArg(output_ir);
     run_lib.step.dependOn(&run_ir.step);
-- 
